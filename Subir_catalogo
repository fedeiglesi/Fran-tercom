import csv
import os
import urllib.parse
import psycopg2
import requests
from io import StringIO

def build_database_url(verbose=True):
    """Return a Postgres connection string from env vars with clear guidance."""

    database_url = os.getenv("DATABASE_URL")
    if database_url:
        if verbose:
            print("🔌 Usando DATABASE_URL (formato completo de conexión)")
        return database_url

    user = os.getenv("POSTGRES_USER")
    password = os.getenv("POSTGRES_PASSWORD")
    host = os.getenv("POSTGRES_HOST")
    dbname = os.getenv("POSTGRES_DB")
    port = os.getenv("POSTGRES_PORT", "5432")

    if all([user, password, host, dbname]):
        if verbose:
            print(
                "🔌 Usando credenciales POSTGRES_* (solo se muestra host/puerto/db):\n"
                f"  HOST: {host}\n  PORT: {port}\n  DB:   {dbname}\n  USER: {user}"
            )

        # Escape password in case it contains special characters
        safe_password = urllib.parse.quote_plus(password)
        return f"postgresql://{user}:{safe_password}@{host}:{port}/{dbname}"

    missing = [
        var for var in ["POSTGRES_USER", "POSTGRES_PASSWORD", "POSTGRES_HOST", "POSTGRES_DB"]
        if os.getenv(var) is None
    ]
    missing_text = ", ".join(missing)
    raise Exception(
        "Faltan datos de conexión. Define DATABASE_URL o todas estas variables: "
        "POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST, POSTGRES_DB (opcional POSTGRES_PORT). "
        f"Variables ausentes: {missing_text or 'ninguna, pero DATABASE_URL tampoco está definido.'}"
    )

# URL RAW DEL CSV EN GITHUB
CSV_URL = "https://raw.githubusercontent.com/fedeiglesi/Fran-tercom/refs/heads/Fran-3.17/catalogo_tercom_ultra_normalizado_faiss_v2_FINAL.csv"

# Descargar CSV desde GitHub
response = requests.get(CSV_URL)
response.raise_for_status()

csvfile = StringIO(response.text)
reader = csv.DictReader(csvfile)

# Conexión a Postgres Railway o local
conn = psycopg2.connect(build_database_url())
cur = conn.cursor()

# Crear tabla si no existe para permitir inserciones/actualizaciones
cur.execute(
    """
    CREATE TABLE IF NOT EXISTS "Catalogo1125" (
        codigo TEXT PRIMARY KEY,
        descripcion TEXT,
        precio_dolares NUMERIC,
        precio_pesos NUMERIC,
        familia TEXT,
        familia_nombre TEXT,
        proveedor_nombre TEXT,
        marca_moto TEXT,
        modelo_moto TEXT,
        descripcion_normalizada TEXT,
        sinonimos TEXT,
        cilindrada TEXT,
        categoria_final TEXT
    );
    """
)

for row in reader:
    cur.execute("""
        INSERT INTO "Catalogo1125" (
            codigo, descripcion, precio_dolares, precio_pesos,
            familia, familia_nombre, proveedor_nombre,
            marca_moto, modelo_moto, descripcion_normalizada,
            sinonimos, cilindrada, categoria_final
        )
        VALUES (
            %(codigo)s, %(descripcion)s, %(precio_dolares)s, %(precio_pesos)s,
            %(familia)s, %(familia_nombre)s, %(proveedor_nombre)s,
            %(marca_moto)s, %(modelo_moto)s, %(descripcion_normalizada)s,
            %(sinonimos)s, %(cilindrada)s, %(categoria_final)s
        )
        ON CONFLICT (codigo) DO UPDATE SET
            descripcion = EXCLUDED.descripcion,
            precio_dolares = EXCLUDED.precio_dolares,
            precio_pesos = EXCLUDED.precio_pesos,
            familia = EXCLUDED.familia,
            familia_nombre = EXCLUDED.familia_nombre,
            proveedor_nombre = EXCLUDED.proveedor_nombre,
            marca_moto = EXCLUDED.marca_moto,
            modelo_moto = EXCLUDED.modelo_moto,
            descripcion_normalizada = EXCLUDED.descripcion_normalizada,
            sinonimos = EXCLUDED.sinonimos,
            cilindrada = EXCLUDED.cilindrada,
            categoria_final = EXCLUDED.categoria_final;
    """, row)

conn.commit()
cur.close()
conn.close()

print("✔ Catálogo Catalogo1125 actualizado correctamente desde GitHub")
