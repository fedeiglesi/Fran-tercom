# ============================================================================
# Variables de Entorno para Fran 4.0 en Railway
# ============================================================================
# Copia este archivo a .env localmente, o configura estas variables en Railway

# ----------------------------------------------------------------------------
# 1. PostgreSQL (CRÍTICO)
# ----------------------------------------------------------------------------
# Railway auto-genera esto si vinculas la base de datos
# Formato: postgresql://usuario:password@host:puerto/database
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/DATABASE

# ----------------------------------------------------------------------------
# 2. OpenAI API (CRÍTICO)
# ----------------------------------------------------------------------------
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modelo de LLM (recomendado: gpt-4o-mini para balance costo/calidad)
MODEL_NAME=gpt-4o-mini

# Modelo de embeddings (recomendado: text-embedding-3-large para mejor precisión)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ----------------------------------------------------------------------------
# 3. Catálogo de Productos (IMPORTANTE)
# ----------------------------------------------------------------------------
# URL pública del CSV (GitHub raw, Dropbox, Google Drive público, etc.)
# Ejemplo GitHub:
CATALOGO_CSV_URL=https://raw.githubusercontent.com/fedeiglesi/Fran-tercom/main/catalogo_tercom_ultra_normalizado_faiss_v2_FINAL.csv

# O ruta local (solo para testing local):
# CATALOGO_CSV_URL=/ruta/absoluta/al/catalogo.csv

# ----------------------------------------------------------------------------
# 4. Configuración de Base de Datos (OPCIONAL)
# ----------------------------------------------------------------------------
# TTL de sesiones en segundos (default: 86400 = 24 horas)
SESSION_TTL_SECONDS=86400

# Número máximo de reintentos de conexión a BD (default: 10)
# Déjalo vacío para reintentos infinitos
DB_INIT_MAX_RETRIES=20

# Delay base entre reintentos en segundos (default: 1.0)
DB_INIT_BASE_DELAY=2.0

# Delay máximo entre reintentos en segundos (default: 10.0)
DB_INIT_MAX_DELAY=30.0

# ----------------------------------------------------------------------------
# 5. Búsqueda y Relevancia (OPCIONAL)
# ----------------------------------------------------------------------------
# Máximo de resultados de búsqueda (default: 60)
MAX_SEARCH_RESULTS=60

# Máximo de items en historial de búsqueda (default: 150)
MAX_ITEMS=150

# Score mínimo de relevancia para aceptar resultados (default: 65.0)
RELEVANCE_MIN_SCORE=65.0

# ----------------------------------------------------------------------------
# 6. Rate Limiting (OPCIONAL)
# ----------------------------------------------------------------------------
# Mensajes máximos por minuto por usuario (default: 30)
RATE_LIMIT_PER_MINUTE=30

# Timeout de requests en segundos (default: 15)
REQUEST_TIMEOUT=15

# ----------------------------------------------------------------------------
# 7. Servidor (Railway lo configura automáticamente)
# ----------------------------------------------------------------------------
# Host del servidor (default: 0.0.0.0)
UVICORN_HOST=0.0.0.0

# Puerto del servidor (Railway usa $PORT automáticamente)
# UVICORN_PORT=8000

# ----------------------------------------------------------------------------
# 8. Variables Legacy (NO NECESARIAS para Fran 4.0)
# ----------------------------------------------------------------------------
# Qdrant no se usa en Fran 4.0 (se migró a pgvector)
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=fran_catalog
# QDRANT_API_KEY=

# ----------------------------------------------------------------------------
# NOTAS IMPORTANTES
# ----------------------------------------------------------------------------
# 1. NO commitees el archivo .env al repositorio (está en .gitignore)
# 2. En Railway, configura estas variables en: Settings → Variables
# 3. Para vincular PostgreSQL en Railway:
#    - Ve a tu servicio web → Variables → + New Variable → Add Reference
#    - Selecciona tu base de datos PostgreSQL
#    - Esto auto-genera DATABASE_URL
# 4. Para verificar configuración, ejecuta:
#    railway run python diagnostico_railway.py
