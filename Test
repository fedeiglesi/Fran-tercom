# ========== CORRECTOR ORTOGRÁFICO - CAPA 1 (n-gramas) ==========
class SpellCorrector:
    """Corrector rápido basado en n-gramas y frecuencia."""
    
    def __init__(self, catalog):
        self.vocabulary = self._build_vocabulary(catalog)
        self.ngram_index = self._build_ngram_index()
    
    def _build_vocabulary(self, catalog):
        word_freq = {}
        for product in catalog:
            text = " ".join([
                product.get("name", ""),
                product.get("brand", ""),
                product.get("category", ""),
                product.get("keywords", ""),
            ]).lower()
            words = re.findall(r'\b\w+\b', text)
            for word in words:
                if len(word) >= 3:
                    word_freq[word] = word_freq.get(word, 0) + 1
        return dict(sorted(word_freq.items(), key=lambda x: x[1], reverse=True))
    
    def _build_ngram_index(self):
        index = {}
        for word in self.vocabulary.keys():
            for ngram in self._get_ngrams(word):
                if ngram not in index:
                    index[ngram] = set()
                index[ngram].add(word)
        return index
    
    def _get_ngrams(self, word, n=3):
        word = f"#{word}#"
        return [word[i:i+n] for i in range(len(word)-n+1)]
    
    def _ngram_similarity(self, word1, word2):
        ng1 = set(self._get_ngrams(word1))
        ng2 = set(self._get_ngrams(word2))
        if not ng1 or not ng2:
            return 0.0
        intersection = len(ng1 & ng2)
        union = len(ng1 | ng2)
        return intersection / union if union > 0 else 0.0
    
    def _get_candidates(self, word, max_candidates=20):
        candidates = set()
        for ngram in self._get_ngrams(word):
            if ngram in self.ngram_index:
                candidates.update(self.ngram_index[ngram])
                if len(candidates) > 100:
                    break
        if len(candidates) < 5:
            prefix = word[:3]
            for vocab_word in self.vocabulary.keys():
                if vocab_word.startswith(prefix):
                    candidates.add(vocab_word)
        return list(candidates)[:max_candidates]
    
    def correct(self, word, context_words=None):
        word = word.lower()
        if word in self.vocabulary or len(word) < 3:
            return word, 1.0
        
        candidates = self._get_candidates(word)
        if not candidates:
            return word, 0.0
        
        scored_candidates = []
        for candidate in candidates:
            ngram_sim = self._ngram_similarity(word, candidate)
            max_len = max(len(word), len(candidate))
            edit_dist = levenshtein_distance(word, candidate)
            edit_sim = 1 - (edit_dist / max_len)
            max_freq = max(self.vocabulary.values())
            freq_score = self.vocabulary[candidate] / max_freq
            context_score = 0.0
            if context_words:
                for ctx_word in context_words:
                    if ctx_word in self.vocabulary:
                        context_score += 0.2
            total_score = (
                0.40 * ngram_sim +
                0.30 * edit_sim +
                0.20 * freq_score +
                0.10 * context_score
            )
            scored_candidates.append((candidate, total_score))
        
        scored_candidates.sort(key=lambda x: x[1], reverse=True)
        best_candidate, best_score = scored_candidates[0]
        
        if best_score > 0.6:
            return best_candidate, best_score
        return word, 0.0

# ========== CORRECTOR EN CASCADA (3 CAPAS) ==========
class CascadeSpellCorrector:
    """Sistema de corrección en cascada: n-gramas → embeddings → LLM"""
    
    def __init__(self, catalog, openai_client):
        self.catalog = catalog
        self.client = openai_client
        self.fast_corrector = SpellCorrector(catalog)
        self.embedding_vocab = self._build_embedding_vocab()
        self.vocab_embeddings_cache = None
        self.stats = {
            "layer1_hits": 0,
            "layer2_hits": 0,
            "layer3_hits": 0,
            "no_correction": 0,
            "total_requests": 0
        }
    
    def _build_embedding_vocab(self):
        vocab = set()
        for cat_list in CATEGORY_MAP.values():
            vocab.update(cat_list)
        vocab.update(["honda", "yamaha", "suzuki", "kawasaki", "bajaj", "motomel", "corven", "zanella", "gilera"])
        vocab.update(["wave", "cg", "fz", "titan", "crypton", "ns", "pulsar", "rouser", "rx"])
        word_freq = {}
        for product in self.catalog:
            text = " ".join([
                product.get("name", ""),
                product.get("brand", ""),
                product.get("category", ""),
            ]).lower()
            words = re.findall(r'\b\w{4,}\b', text)
            for word in words:
                word_freq[word] = word_freq.get(word, 0) + 1
        top_words = sorted(word_freq.items(), key=lambda x: x[1], reverse=True)[:300]
        vocab.update([w for w, _ in top_words])
        return list(vocab)
    
    def _get_vocab_embeddings(self):
        if self.vocab_embeddings_cache is None:
            logger.info("🔄 Generando embeddings de vocabulario...")
            vectors = generate_embeddings_with_cache(self.embedding_vocab)
            vecs = np.array(vectors).astype("float32")
            faiss.normalize_L2(vecs)
            self.vocab_embeddings_cache = vecs
            logger.info("✅ Embeddings de vocabulario cargados")
        return self.vocab_embeddings_cache
    
    def _correct_layer1_fast(self, word, context_words):
        corrected, confidence = self.fast_corrector.correct(word, context_words)
        if confidence >= 0.80:
            self.stats["layer1_hits"] += 1
            logger.debug(f"✅ L1: '{word}' → '{corrected}' ({confidence:.2f})")
            return corrected, confidence, "layer1"
        return None, confidence, None
    
    def _correct_layer2_embeddings(self, word, context_words):
        try:
            word_emb = generate_embeddings_with_cache([word])[0]
            word_vec = np.array([word_emb]).astype("float32")
            faiss.normalize_L2(word_vec)
            vocab_vecs = self._get_vocab_embeddings()
            similarities = np.dot(vocab_vecs, word_vec.T).flatten()
            best_idx = np.argmax(similarities)
            best_similarity = float(similarities[best_idx])
            best_word = self.embedding_vocab[best_idx]
            context_boost = 0.0
            if context_words:
                for ctx in context_words:
                    if ctx in best_word or best_word in ctx:
                        context_boost = 0.05
                        break
            confidence = min(best_similarity + context_boost, 1.0)
            if confidence >= 0.70:
                self.stats["layer2_hits"] += 1
                logger.debug(f"✅ L2: '{word}' → '{best_word}' ({confidence:.2f})")
                return best_word, confidence, "layer2"
            return None, confidence, None
        except Exception as e:
            logger.warning(f"Error en L2: {e}")
            return None, 0.0, None
    
    def _correct_layer3_llm(self, word, context_words, full_query):
        try:
            context_str = " ".join(context_words) if context_words else ""
            prompt = f"""Corrige SOLO la ortografía en contexto de motopartes:
Palabra: "{word}"
Contexto: "{context_str}"
Query: "{full_query}"
Vocabulario: bateria, aceite, filtro, cadena, bujia, amortiguador
Responde SOLO con la palabra corregida (una palabra)."""
            
            with openai_sem:
                resp = self.client.chat.completions.create(
                    model=MODEL_NAME,
                    temperature=0,
                    max_tokens=10,
                    messages=[
                        {"role": "system", "content": "Corrector ortográfico de una palabra."},
                        {"role": "user", "content": prompt}
                    ],
                    timeout=REQUESTS_TIMEOUT
                )
            corrected = resp.choices[0].message.content.strip().lower()
            if len(corrected.split()) == 1 and corrected != word:
                self.stats["layer3_hits"] += 1
                logger.debug(f"✅ L3: '{word}' → '{corrected}'")
                return corrected, 0.95, "layer3"
            return None, 0.0, None
        except Exception as e:
            logger.warning(f"Error en L3: {e}")
            return None, 0.0, None
    
    def correct_word(self, word, context_words=None, full_query="", use_llm=False):
        self.stats["total_requests"] += 1
        word = word.lower().strip()
        if len(word) < 3 or word.isdigit():
            return word, 1.0, "skip"
        if word in self.embedding_vocab:
            return word, 1.0, "exact_match"
        
        corrected, conf, layer = self._correct_layer1_fast(word, context_words)
        if corrected:
            return corrected, conf, layer
        
        corrected, conf, layer = self._correct_layer2_embeddings(word, context_words)
        if corrected:
            return corrected, conf, layer
        
        if use_llm and full_query:
            corrected, conf, layer = self._correct_layer3_llm(word, context_words, full_query)
            if corrected:
                return corrected, conf, layer
        
        self.stats["no_correction"] += 1
        return word, 0.0, "no_correction"
    
    def correct_query(self, query, use_llm=False):
        words = query.lower().split()
        corrected_words = []
        corrections = []
        layer_stats = {"layer1": 0, "layer2": 0, "layer3": 0}
        
        for i, word in enumerate(words):
            context = []
            if i > 0:
                context.append(words[i-1])
            if i < len(words) - 1:
                context.append(words[i+1])
            
            corrected, confidence, layer = self.correct_word(
                word, context_words=context, full_query=query, use_llm=use_llm
            )
            corrected_words.append(corrected)
            if corrected != word and layer and layer.startswith("layer"):
                corrections.append({
                    "original": word,
                    "corrected": corrected,
                    "confidence": confidence,
                    "layer": layer
                })
                layer_stats[layer] = layer_stats.get(layer, 0) + 1
        
        corrected_query = " ".join(corrected_words)
        return corrected_query, corrections, layer_stats
    
    def get_stats(self):
        if self.stats["total_requests"] == 0:
            return self.stats
        total = self.stats["total_requests"]
        return {
            **self.stats,
            "layer1_percent": round(100 * self.stats["layer1_hits"] / total, 1),
            "layer2_percent": round(100 * self.stats["layer2_hits"] / total, 1),
            "layer3_percent": round(100 * self.stats["layer3_hits"] / total, 1),
        }

# ========== PROCESADOR DE LISTAS MASIVAS ==========
class BulkListProcessor:
    """Procesador optimizado para listas largas con batch LLM."""
    
    def __init__(self, openai_client, catalog):
        self.client = openai_client
        self.catalog = catalog
        self.stats = {
            "lists_processed": 0,
            "total_items": 0,
            "corrections_made": 0
        }
    
    def is_bulk_list(self, text):
        if not text or len(text) < 20:
            return False
        lines = [l.strip() for l in text.split('\n') if l.strip()]
        if len(lines) < 3:
            return False
        qty_pattern_count = sum(1 for l in lines if re.match(r'^\d+\s+\w', l))
        return qty_pattern_count >= 2
    
    def normalize_and_correct_batch(self, raw_list):
        prompt = f"""Sos procesador de pedidos de motopartes.
Normaliza y corrige ortografía manteniendo formato exacto.
REGLAS:
1. Formato: "cantidad producto"
2. Corregir SOLO ortografía
3. NO cambiar cantidades
4. NO explicaciones
Vocabulario: bateria, aceite, filtro, cadena, bujia, amortiguador, honda, yamaha, suzuki
INPUT:
{raw_list}
OUTPUT:"""
        
        try:
            with openai_sem:
                resp = self.client.chat.completions.create(
                    model=MODEL_NAME,
                    temperature=0,
                    max_tokens=1500,
                    messages=[
                        {"role": "system", "content": "Normalizador de listas. Solo devuelves la lista corregida."},
                        {"role": "user", "content": prompt}
                    ],
                    timeout=REQUESTS_TIMEOUT * 2
                )
            corrected_list = resp.choices[0].message.content.strip()
            if corrected_list.startswith("```"):
                corrected_list = re.sub(r'```[\w]*\n?', '', corrected_list)
            return corrected_list.strip()
        except Exception as e:
            logger.error(f"Error en batch correction: {e}")
            return raw_list
    
    def parse_corrected_list(self, corrected_list):
        items = []
        lines = corrected_list.strip().split('\n')
        for line in lines:
            line = line.strip()
            if not line:
                continue
            match = re.match(r'^(\d+)\s+(.+)$', line)
            if match:
                qty = int(match.group(1))
                product = match.group(2).strip()
                items.append({"qty": qty, "product": product, "raw": line})
            else:
                items.append({"qty": 1, "product": line, "raw": line})
        return items
    
    def search_item(self, product_query):
        try:
            results = semantic_search_v2(product_query, top_k=3)
            if results:
                best_match = results[0]
                product_data = best_match[0] if isinstance(best_match, tuple) else best_match
                score = best_match[1] if isinstance(best_match, tuple) else 0.9
                return {"found": True, "product": product_data, "confidence": score}
            return {"found": False, "product": None, "confidence": 0.0}
        except Exception as e:
            logger.error(f"Error buscando '{product_query}': {e}")
            return {"found": False, "product": None, "confidence": 0.0}
    
    def process_bulk_list(self, raw_list):
        start_time = time.time()
        self.stats["lists_processed"] += 1
        
        logger.info(f"📝 Procesando lista de {len(raw_list.split(chr(10)))} líneas")
        corrected_list = self.normalize_and_correct_batch(raw_list)
        
        original_lines = [l.strip() for l in raw_list.split('\n') if l.strip()]
        corrected_lines = [l.strip() for l in corrected_list.split('\n') if l.strip()]
        corrections_count = sum(1 for orig, corr in zip(original_lines, corrected_lines) if orig != corr)
        self.stats["corrections_made"] += corrections_count
        
        if corrections_count > 0:
            logger.info(f"🔧 {corrections_count} líneas corregidas")
        
        parsed_items = self.parse_corrected_list(corrected_list)
        self.stats["total_items"] += len(parsed_items)
        
        results_found = []
        results_not_found = []
        
        for item in parsed_items:
            search_result = self.search_item(item["product"])
            if search_result["found"]:
                product_data = search_result["product"]
                results_found.append({
                    "requested_qty": item["qty"],
                    "requested_product": item["product"],
                    "found_code": product_data.get("code", ""),
                    "found_name": product_data.get("name", ""),
                    "price_ars": product_data.get("price_ars", 0),
                    "price_usd": product_data.get("price_usd", 0),
                    "subtotal_ars": float(product_data.get("price_ars", 0)) * item["qty"],
                    "confidence": search_result["confidence"]
                })
            else:
                results_not_found.append({
                    "requested_qty": item["qty"],
                    "requested_product": item["product"],
                    "raw_line": item["raw"]
                })
        
        processing_time = int((time.time() - start_time) * 1000)
        
        return {
            "success": True,
            "items_found": results_found,
            "items_not_found": results_not_found,
            "total_requested": len(parsed_items),
            "found_count": len(results_found),
            "not_found_count": len(results_not_found),
            "corrections_made": corrections_count,
            "processing_time_ms": processing_time
        }
    
    def get_stats(self):
        return self.stats

